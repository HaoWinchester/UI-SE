STITCH_API_KEY=
STITCH_ACCESS_TOKEN=
GOOGLE_CLOUD_PROJECT=
STITCH_PROJECT_ID=
STITCH_HOST=https://stitch.googleapis.com/mcp
STITCH_TIMEOUT_MS=300000
STITCH_DEVICE_TYPE=DESKTOP
STITCH_MODEL_ID=
STITCH_PROXY_URL=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# 如果不填 DATABASE_URL，运行时会自动尝试拉起本地 Docker PostgreSQL，
# 默认连接串为 postgresql://postgres:postgres@127.0.0.1:55432/ui_se
DATABASE_URL=
POSTGRES_AUTO_START=true
POSTGRES_DOCKER_IMAGE=postgres:16-alpine
POSTGRES_DOCKER_CONTAINER=ui-se-postgres
POSTGRES_DOCKER_PORT=55432
DATABASE_CONNECT_TIMEOUT_MS=8000
TARGET_ENV=staging
